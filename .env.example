# Supabase (proyecto → Settings → API)
# Copia este archivo a .env y rellena los valores. No subas .env al repositorio.
#
# Usuarios: crearlos en Dashboard → Authentication → Users (o admin API).
# La app no incluye registro/autoservicio en el cliente.

VITE_SUPABASE_URL=https://TU_REF.supabase.co
VITE_SUPABASE_ANON_KEY=tu_clave_anon_publica
